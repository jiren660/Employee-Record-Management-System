            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"name\": \"Juan Dela Cruz\",\n  \"email\": \"juan.updated@example.com\",\n  \"position\": \"Senior Developer\",\n  \"salary\": 45000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost/employee_management/employee_api.php",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "path": [
            "employee_management",
            "employee_api.php"
          ]
        },
        "description": "Updates an existing employee record by ID with a raw JSON payload."
