    {
      "name": "1. GET - Retrieve All Employees",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost/employee_management/employee_api.php",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "path": [
            "employee_management",
            "employee_api.php"
          ]
        },
        "description": "Fetches the complete directory of employees ordered by ID descending."
