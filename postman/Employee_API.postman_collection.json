          "raw": "http://localhost/employee_management/employee_api.php?id=1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "path": [
            "employee_management",
            "employee_api.php"
          ],
          "query": [
            {
              "key": "id",
              "value": "1"
            }
          ]
        },
        "description": "Retrieves the full record of a single employee matching the query parameter id."
      },
      "response": []
    },
    {
      "name": "3. POST - Add New Employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Juan Dela Cruz\",\n  \"email\": \"juan@example.com\",\n  \"position\": \"Software Developer\",\n  \"salary\": 35000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost/employee_management/employee_api.php",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "path": [
            "employee_management",
            "employee_api.php"
          ]
        },
        "description": "Creates a new employee record using a raw JSON payload with Content-Type: application/json."
      },
      "response": []
    },
    {
