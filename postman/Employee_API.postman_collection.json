      "response": []
    },
    {
      "name": "5. DELETE - Delete Employee",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost/employee_management/employee_api.php?id=1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "path": [
            "employee_management",
            "employee_api.php"
          ],
          "query": [
            {
              "key": "id",
              "value": "1"
            }
          ]
        },
        "description": "Removes an employee record from the database by ID."
